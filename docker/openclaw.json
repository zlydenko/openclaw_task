{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "controlUi": {
      "enabled": true
    },
    "auth": {
      "mode": "token",
      "token": {
        "source": "file",
        "provider": "gatewayfile",
        "id": "value"
      },
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000
      }
    }
  },
  "secrets": {
    "providers": {
      "gatewayfile": {
        "source": "file",
        "path": "/run/openclaw-secrets/gateway_token",
        "mode": "singleValue"
      },
      "openrouterfile": {
        "source": "file",
        "path": "/run/openclaw-secrets/openrouter_api_key",
        "mode": "singleValue"
      }
    }
  },
  "models": {
    "providers": {
      "openrouter": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "api": "openai-completions",
        "apiKey": {
          "source": "file",
          "provider": "openrouterfile",
          "id": "value"
        },
        "models": [
          {
            "id": "moonshotai/kimi-k2-thinking",
            "name": "Kimi K2 Thinking",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 262144,
            "maxTokens": 4096
          },
          {
            "id": "google/gemini-2.5-flash-lite",
            "name": "Gemini 2.5 Flash-Lite",
            "api": "openai-completions",
            "reasoning": false,
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 1048576,
            "maxTokens": 4096,
            "cost": {
              "input": 0.1,
              "output": 0.4,
              "cacheRead": 0.01,
              "cacheWrite": 0.08333
            }
          }
        ]
      }
    }
  },
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "maxConcurrent": 3,
      "model": {
        "primary": "openrouter/moonshotai/kimi-k2-thinking"
      },
      "models": {
        "openrouter/moonshotai/kimi-k2-thinking": {
          "params": {
            "extraBody": {
              "reasoning": {
                "enabled": true,
                "exclude": true
              }
            }
          }
        }
      },
      "heartbeat": {
        "every": "0m"
      },
      "timeoutSeconds": 180,
      "imageModel": {
        "primary": "openrouter/google/gemini-2.5-flash-lite"
      }
    },
    "entries": {
      "main": {
        "workspace": "/home/node/.openclaw/workspace"
      }
    }
  },
  "tools": {
    "profile": "full",
    "toolSearch": true,
    "codeMode": {
      "enabled": "auto",
      "executor": "quickjs"
    },
    "elevated": {
      "enabled": false
    },
    "loopDetection": {
      "enabled": true
    }
  },
  "memory": {
    "search": {
      "enabled": true,
      "rememberAcrossConversations": true,
      "provider": "none"
    }
  },
  "browser": {
    "enabled": true,
    "headless": true,
    "noSandbox": false,
    "defaultProfile": "openclaw",
    "ssrfPolicy": {
      "dangerouslyAllowPrivateNetwork": false
    },
    "executablePath": "/usr/local/bin/chromium"
  },
  "plugins": {
    "allow": [
      "openrouter",
      "memory-core",
      "active-memory",
      "browser",
      "code-mode-quickjs"
    ],
    "entries": {
      "memory-core": {
        "enabled": true,
        "config": {
          "dreaming": {
            "enabled": false
          }
        }
      },
      "active-memory": {
        "enabled": true
      },
      "browser": {
        "enabled": true
      },
      "code-mode-quickjs": {
        "enabled": true
      }
    }
  },
  "cron": {
    "enabled": true,
    "skipMissedJobs": true
  },
  "skills": {
    "workshop": {
      "autonomous": {
        "mode": "propose"
      }
    }
  }
}

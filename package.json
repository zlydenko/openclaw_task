{
  "name": "openclaw-assessment",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspace @assessment/api",
    "start": "npm start --workspace @assessment/api",
    "dev": "npm run dev --workspace @assessment/api",
    "check": "npm run check --workspace @assessment/api && npm run lint && npm run format:check",
    "lint": "oxlint apps/api/src",
    "format": "oxfmt apps/api/src package.json apps/api/package.json apps/api/tsconfig.json",
    "format:check": "oxfmt --check apps/api/src package.json apps/api/package.json apps/api/tsconfig.json"
  },
  "devDependencies": {
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
